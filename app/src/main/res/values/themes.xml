<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CampusSchedule" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!--
          启动窗口背景：和 Compose 里启动动画的第一帧完全同色（Tokens.Paper #F6F9FF）。
          系统冷启动时会先显示这块底色，再切到 Activity 的 Compose 内容 ——
          两者同色，切换那一帧就看不出来，避免「白屏闪一下」。
        -->
        <item name="android:windowBackground">@color/paper</item>
    </style>
</resources>